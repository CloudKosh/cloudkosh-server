{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Run Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/index.js",
            "env": {
            },
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js",
                "${workspaceFolder}/node_modules/@entity-access/**/*.js",
            ]
        },
        {
            "name": "Attach to Process",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "localRoot": "${workspaceRoot}",
            "remoteRoot": "/app/",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js",
                "${workspaceFolder}/node_modules/@entity-access/**/*.js",
            ]
        },
        {
            "name": "Attach to Process 1",
            "type": "node",
            "request": "attach",
            "port": 9230,
            "localRoot": "${workspaceRoot}",
            "remoteRoot": "/app/",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js",
                "${workspaceFolder}/node_modules/@entity-access/**/*.js",
            ]
        },
        {
            "name": "Attach to Process 2",
            "type": "node",
            "request": "attach",
            "port": 9231,
            "localRoot": "${workspaceRoot}",
            "remoteRoot": "/app/",
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js",
                "${workspaceFolder}/node_modules/@entity-access/**/*.js",
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Test Selected File",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--enable-source-maps"
            ],
            "program": "${workspaceFolder}/dist/tests/test.js",
            "env": {
                "CASTING_SERVER_TEST_MODE": "true",
                "CASTING_SERVER_DB_TEST_MODE": "true"
            },
            "args": [
                "--test-file",
                "${file}"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js",
                "${workspaceFolder}/node_modules/@entity-access/**/*.js",
            ]
        }
    ]
}